<%- include('partials/header', { active: 'home', pageTitle: 'Home', config }) %>

<div class="hero">
  <div class="wrap has-sigils">
    <button class="sigil" data-sigil="1" style="bottom:1rem;right:1rem;font-size:2.4rem" aria-label="A strange marking">ᛟ</button>
    <div class="kicker">AN ANIMATED HORROR SERIES BY MAYA CLARK</div>
    <h1>THE DEAD <span>DON'T</span> FORGET</h1>
    <div class="tagline"><%= config.tagline %></div>
    <div class="cta-row">
      <a class="btn" href="/episodes">Watch Free</a>
      <a class="btn ghost" href="/bonus">Bonus Store</a>
    </div>
    <% if (config.seriesTrailerYoutubeId) { %>
    <div class="trailer-facade" id="hero-trailer" role="button" tabindex="0" aria-label="Play the series trailer">
      <img src="/img/series-key-art.webp?v=<%= config.assetV %>" alt="THE DEAD DON'T FORGET — series trailer" loading="lazy">
      <span class="trailer-play"><span>&#9654;</span></span>
      <span class="trailer-facade-label">WATCH THE TRAILER</span>
    </div>
    <script>
    (function () {
      var f = document.getElementById('hero-trailer');
      if (!f) return;
      function play() {
        var frame = document.createElement('iframe');
        frame.src = 'https://www.youtube-nocookie.com/embed/<%= config.seriesTrailerYoutubeId %>?autoplay=1&rel=0';
        frame.title = "THE DEAD DON'T FORGET — series trailer";
        frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        frame.allowFullscreen = true;
        f.innerHTML = '';
        f.appendChild(frame);
        f.removeAttribute('role');
      }
      f.addEventListener('click', play);
      f.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); } });
    })();
    </script>
    <% } %>
    <div style="margin-top:1.2rem">
      <%- include('partials/donate', { compact: false }) %>
    </div>
  </div>
</div>

<%
/* Latest live locked episode = highest-numbered lockedEpisode with a wired
   video ID. Always shows the real newest drop — never goes stale. */
const liveLocked = config.lockedEpisodes.filter(ep => config['ep' + ep.n + 'VideoId']);
const latest = liveLocked.length ? liveLocked[liveLocked.length - 1] : null;
const latestArt = latest ? ((config.lockedArt && config.lockedArt[latest.n]) || '/img/series-key-art.webp') : null;
%>
<% if (latest) { %>
<section>
  <div class="wrap">
    <h2>Latest <span>Drop</span></h2>
    <p class="section-sub">Episode <%= latest.n %>: &ldquo;<%= latest.title %>&rdquo; — fresh from the vault. Website exclusive.</p>
    <div class="episode-block locked-episode">
      <div class="locked-poster">
        <img src="<%= latestArt %>?v=<%= config.assetV %>" alt="Episode <%= latest.n %>: <%= latest.title %> — locked" loading="lazy">
        <span class="locked-badge">LOCKED</span>
        <% if (config.trailers && config.trailers[latest.n]) { %>
        <button type="button" class="trailer-btn" data-trailer="<%= config.trailers[latest.n] %>" data-title="Episode <%= latest.n %>: <%= latest.title %>">&#9654; Trailer</button>
        <% } %>
      </div>
      <h3>Episode <%= latest.n %>: <%= latest.title %></h3>
      <div class="meta"><%= latest.runtime %> &middot; Website Exclusive</div>
      <p class="section-sub"><%= latest.synopsis %></p>
      <a class="btn" href="/bonus">Unlock Episode <%= latest.n %> — $2.99</a>
    </div>
  </div>
</section>
<% } %>

<section>
  <div class="wrap has-sigils">
    <button class="sigil" data-sigil="2" style="bottom:.4rem;left:.8rem" aria-label="A strange marking">ᛞ</button>
    <h2>The <span>Episodes</span></h2>
    <p class="section-sub">The first three episodes stream free. The Bonus Store is where the story continues.</p>
    <div class="cards">
      <% config.episodes.forEach(ep => { %>
      <div class="card">
        <div class="thumb"><img src="<%= ep.poster %>" alt="Poster for Episode <%= ep.n %>: <%= ep.title %>"></div>
        <div class="card-body">
          <div class="ep-num">EPISODE <%= ep.n %></div>
          <h3><%= ep.title %></h3>
          <div class="runtime"><%= ep.runtime %></div>
          <p><%= ep.synopsis %></p>
          <a class="btn" href="/episodes">Watch Free</a>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="handoff-card">
      <div class="handoff-kicker">THE STORY DOESN'T STOP HERE</div>
      <h3>Finished Episode 3? The Ledger was only the beginning.</h3>
      <p class="section-sub">Episode 4: "The Man That Wasn't There" — a man who was never there, and Daniel can't stop remembering him. Website exclusive. Pay once, yours forever.</p>
      <div class="cta-row">
        <a class="btn" href="/bonus">Continue the story — $2.99</a>
        <% if (config.trailers && config.trailers[4]) { %>
        <button type="button" class="btn ghost trailer-btn" data-trailer="<%= config.trailers[4] %>" data-title="Episode 4: The Man That Wasn't There">&#9654; Watch the trailer</button>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Go <span>Deeper</span></h2>
    <p class="section-sub">Early premieres and official art — straight from the creator.</p>
    <% Object.entries(config.products).forEach(([id, p]) => { %>
    <div class="product">
      <div>
        <h3><%= p.name %></h3>
        <div class="tagline"><%= p.tagline %></div>
      </div>
      <a class="btn" href="/bonus">Unlock — $<%= (p.priceCents/100).toFixed(2) %></a>
    </div>
    <% }) %>
  </div>
</section>

<section>
  <div class="wrap about-creator">
    <div class="about-portrait">
      <img src="/img/creator-portrait-placeholder.webp?v=<%= config.assetV %>" alt="Maya Clark — portrait coming soon" loading="lazy">
    </div>
    <div class="about-copy">
      <h2>About the <span>Creator</span></h2>
      <p>Maya Clark writes, directs, and produces <strong>THE DEAD DON'T FORGET</strong> — a 69-episode horror audio drama on Pocket FM, now reborn as a full 2D animated series.</p>
      <p>Every episode is built under her direction: the voices you hear, the dread you feel, the names you can't forget. This site is the only place to watch new episodes first — before anywhere else, if anywhere else at all.</p>
    </div>
  </div>
</section>

<section>
  <div class="wrap gate">
    <h2>The Full <span>Story</span></h2>
    <div class="has-sigils" style="position:relative">
      <button class="sigil" data-sigil="5" style="top:-.6rem;right:12%" aria-label="A strange marking">ᚨ</button>
      <p>69 episodes of the original audio series — free on Pocket FM.</p>
    </div>
    <a class="btn ghost" href="<%= config.pocketFmUrl %>" target="_blank" rel="noopener">Listen on Pocket FM</a>
  </div>
</section>

<section>
  <div class="wrap gate">
    <h2>The <span>Haunting</span> Ground</h2>
    <p class="section-sub">The dead are restless tonight. Touch the wall. Light a candle. Banish what rises. Five sigils hide across this page.</p>
  </div>
</section>

<section>
  <div class="wrap gate has-sigils">
    <button class="sigil" data-sigil="3" style="top:.2rem;left:.6rem" aria-label="A strange marking">ᛚ</button>
    <h2>The Wall <span>Is Listening</span></h2>
    <p class="section-sub">Tap a name. Lean in close — they don't speak loudly anymore.</p>
    <div id="wall-of-names" class="name-wall" role="list" aria-label="Wall of the dead"></div>
  </div>
</section>

<section>
  <div class="wrap gate has-sigils">
    <button class="sigil" data-sigil="4" style="top:.2rem;right:.8rem" aria-label="A strange marking">ᛇ</button>
    <h2>Light a <span>Candle</span></h2>
    <p class="section-sub">One flame for each of them. They notice.</p>
    <p class="section-sub"><strong><span id="candle-count">…</span> <span id="candle-word">candles</span></strong> burning for the dead.</p>
    <div id="candle-shrine" class="shrine" role="group" aria-label="Thirteen candles"></div>
    <p>
      <button id="light-all" class="btn" type="button">Light them all</button>
      <button id="snuff-all" class="btn btn-ghost" type="button">Snuff them all</button>
    </p>
    <p class="fine">You have lit <span id="my-candles">0/13</span>. Light them all, and something wakes.</p>
  </div>
</section>

<section>
  <div class="wrap gate">
    <h2>Banish the <span>Risen</span></h2>
    <p class="section-sub">Apparitions surface unbidden across this site. Tap one to release it — <strong><span id="souls-count">0</span> souls released</strong> by you so far.</p>
  </div>
</section>

<section>
  <div class="wrap gate">
    <h2>Find All <span>Five</span></h2>
    <p class="section-sub"><strong>How to hunt:</strong> the sigils are faint — barely a glimmer, like something half-seen from the corner of your eye. Tap anything that shimmers. Found sigils light up and stay lit.</p>
    <div id="sigil-dots" class="sigil-dots" aria-label="Sigils found"><span></span><span></span><span></span><span></span><span></span></div>
    <p class="fine"><span id="sigil-count">0</span>/5 found.</p>
    <p id="sigil-reward" hidden>The dead acknowledge you. They whisper a single name: <strong>ELIAS</strong>… — he hides in the dark corners of this site. Tap everything.</p>
  </div>
</section>

<section>
  <div class="wrap gate">
    <h2>Hear It <span>First</span></h2>
    <p class="section-sub">New episodes drop without warning. Leave your email and the dead will whisper when the next one rises. No spam — only the drop.</p>
    <form id="alert-form" class="alert-form">
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email for new-episode alerts">
      <button class="btn" type="submit">Whisper to me</button>
    </form>
    <p id="alert-msg" class="fine" aria-live="polite"></p>
  </div>
</section>
<script>
(function () {
  var form = document.getElementById('alert-form');
  if (!form) return;
  var msg = document.getElementById('alert-msg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = form.email.value.trim();
    msg.textContent = 'Listening…';
    fetch('/api/alerts/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (d.ok) {
        msg.textContent = 'Done. When the next episode rises, you\u2019ll hear it first.';
        form.reset();
      } else {
        msg.textContent = 'That email doesn\u2019t look right — try again.';
      }
    }).catch(function () {
      msg.textContent = 'The dead are quiet right now — try again in a moment.';
    });
  });
})();
</script>

<%- include('partials/trailer-modal', {}) %>

<%- include('partials/footer', { config }) %>
