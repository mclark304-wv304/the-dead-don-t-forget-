<%- include('partials/header', { active: 'bonus', pageTitle: 'Bonus Store', config }) %>

<section>
  <div class="wrap">
    <h2>Bonus <span>Store</span></h2>
    <p class="section-sub">Early premieres and official art. Pay once, yours forever.</p>
    <p class="section-sub">Secure checkout via PayPal<%= stripeOn ? ' or card (Stripe)' : '' %>.</p>

    <%- include('partials/donate', { compact: false }) %>

    <%- include('partials/thirteen-doors') %>

    <% if (notice.restored) { %>
      <div class="notice">Access restored — your purchases are unlocked on this device.</div>
    <% } %>
    <% if (notice.cancelled) { %>
      <div class="notice">Checkout was cancelled. No charge was made.</div>
    <% } %>
    <% if (notice.error === 'no-purchases') { %>
      <div class="notice">No purchases found for that email. Check the spelling, or buy below.</div>
    <% } %>
    <% if (notice.error === 'bad-email') { %>
      <div class="notice">That doesn't look like an email address. Try again.</div>
    <% } %>

    <div id="checkout-error" class="notice" style="display:none"></div>

    <% /* Thumbnails for every product. Episode art mirrors the /episodes
          locked cards; future episodes fall back to series key art. */ %>
    <% const PRODUCT_THUMBS = {
      'bundle-10': '/img/series-key-art.webp',
      'ep4-early': '/img/apparitions/elias.jpg',
      'ep5-early': '/img/apparitions/lena-mercer.jpg',
      'ep6-early': '/img/apparitions/ruth-mercer.jpg',
      'ep7-early': '/img/wall/evelyn-shaw.jpg',
      'ep8-early': '/img/wall/claire.jpg',
      'ep9-early': '/img/apparitions/jonah-bell.jpg',
      'ep10-early': '/img/ep1-poster-man-at-the-gate.webp',
      'ep11-early': '/img/apparitions/mara.jpg',
      'ep12-early': '/img/wall/marcus.jpg',
      'ep13-early': '/img/series-key-art.webp',
      'ep14-early': '/img/ep3-poster-the-ledger.webp',
      'ep15-early': '/img/wall/daniel-vale.jpg',
      'ep16-early': '/img/apparitions/elias.jpg',
      'ep17-early': '/img/series-key-art.webp',
      'ep18-early': '/img/ep18-the-original.webp',
      'ep19-early': '/img/ep19-the-woman-in-the-memories.webp',
      'ep20-early': '/img/ep20-the-witness.webp',
      'ep21-early': '/img/ep21-the-man-behind-the-glass.webp',
      'ep22-early': '/img/ep22-the-city-was-breathing.webp',
      'ep23-early': '/img/ep23-thefortyfourthdoor.webp',
      'ep24-early': '/img/ep24-the-name-beneath-the-names.webp',
      'ep25-early': '/img/ep25-the-last-name.webp',
      'ep26-early': '/img/ep26-the-archive-beneath-the-house.webp',
      'ep27-early': '/img/ep27-the-secret-daniel-buried.webp',
      'ep28-early': '/img/ep28-the-four-chair.webp',
      'ep29-early': '/img/ep29-the-memory-that-was-witnessed.webp',
      'ep30-early': '/img/ep30-check-point-233.webp',
      'ep31-early': '/img/ep31-the-hand-that-kept-the-record.webp',
      'poster-pack': '/img/ep1-poster-man-at-the-gate.webp',
      'complete-scripts': '/img/series-key-art.webp',
      'character-art-pack': '/img/wall/daniel-vale.jpg'
    };
    const FREEBIE_THUMBS = {
      '/free/ep1-script': '/img/ep1-poster-man-at-the-gate.webp',
      '/free/wallpaper': '/img/series-key-art.webp',
      '/free/poster': '/img/series-key-art.webp'
    }; %>

    <% Object.entries(config.products).forEach(([id, p]) => { %>
    <div class="product">
      <img class="product-thumb" src="<%= (PRODUCT_THUMBS[id] || '/img/series-key-art.webp') %>?v=<%= config.assetV %>" alt="" loading="lazy">
      <div>
        <h3><%= p.name %></h3>
        <div class="tagline"><%= p.tagline %></div>
      </div>
      <div class="unlock-form">
        <div class="price">$<%= (p.priceCents/100).toFixed(2) %></div>
        <div class="pay-row">
          <button class="btn" data-checkout="<%= id %>" data-via="paypal">Unlock — PayPal</button>
          <% if (stripeOn) { %>
          <button class="btn-stripe" data-checkout="<%= id %>" data-via="stripe">Card</button>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>

    <h2 style="margin-top:3rem">Free <span>Downloads</span></h2>
    <p class="section-sub">On the house. No payment, no account — just take them.</p>

    <% config.freebies.forEach(f => { %>
    <div class="product">
      <img class="product-thumb" src="<%= (FREEBIE_THUMBS[f.downloadPath] || '/img/series-key-art.webp') %>?v=<%= config.assetV %>" alt="" loading="lazy">
      <div>
        <h3><%= f.name %> <span class="free-badge">FREE</span></h3>
        <div class="tagline"><%= f.tagline %></div>
      </div>
      <div class="unlock-form">
        <a class="btn" href="<%= f.downloadPath %>">Download</a>
      </div>
    </div>
    <% }) %>

    <div class="restore">
      <h2>Already <span>bought?</span></h2>
      <p class="section-sub">Enter the email you paid with to restore access on this device.</p>
      <form method="POST" action="/api/restore">
        <input type="email" name="email" placeholder="you@example.com" required>
        <button class="btn" type="submit" style="margin-left:.6rem">Restore access</button>
      </form>
    </div>
  </div>
</section>

<script>
document.querySelectorAll('[data-checkout]').forEach(btn => {
  btn.addEventListener('click', async () => {
    btn.disabled = true;
    const box = document.getElementById('checkout-error');
    box.style.display = 'none';
    try {
      const endpoint = btn.dataset.via === 'stripe'
        ? '/api/stripe/checkout/' + btn.dataset.checkout
        : '/api/checkout/' + btn.dataset.checkout;
      const r = await fetch(endpoint, { method: 'POST' });
      const data = await r.json();
      if (data.url) { window.location = data.url; return; }
      throw new Error(data.error || 'Checkout failed.');
    } catch (e) {
      box.textContent = e.message;
      box.style.display = 'block';
      btn.disabled = false;
    }
  });
});
</script>

<%- include('partials/footer', { config }) %>
