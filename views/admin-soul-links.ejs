<%- include('partials/header', { active: '', pageTitle: 'Soul link usage', config }) %>

<section>
  <div class="wrap gate">
    <h2>Soul links</h2>
    <p class="dim"><%= rows.length %> links &middot; counts are live</p>
    <table class="soul-table">
      <thead>
        <tr><th>Link</th><th>Label</th><th>Used</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td class="url"><a href="<%= r.url %>"><%= r.url %></a></td>
            <td><%= r.label %></td>
            <td><%= r.claims %> / <%= r.max %></td>
            <td><span class="badge <%= r.claimed ? 'claimed' : 'open' %>"><%= r.claimed ? 'CLAIMED' : 'AVAILABLE' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<style>
.soul-table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; font-size: .95rem; }
.soul-table th, .soul-table td { padding: .7rem .9rem; text-align: left; border-bottom: 1px solid #2a2a2a; vertical-align: top; }
.soul-table th { color: var(--dim); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .06em; }
.soul-table td.url a { color: #c9a06a; word-break: break-all; }
.soul-table .badge { display: inline-block; padding: .25rem .7rem; border-radius: 999px; font-size: .78rem; font-weight: 700; letter-spacing: .08em; }
.soul-table .badge.open { background: #12351f; color: #7ddf9a; border: 1px solid #1f5c34; }
.soul-table .badge.claimed { background: #3d0f0f; color: #ff7a7a; border: 1px solid #6e1a1a; }
</style>

<%- include('partials/footer', { config }) %>
