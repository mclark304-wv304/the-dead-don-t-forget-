<%- include('partials/header', { active: '', pageTitle: 'Soul link claimed', config }) %>

<section>
  <div class="wrap gate">
    <h2>You&rsquo;re on the list.</h2>
    <p>This soul link has been claimed<% if (label) { %> (<%= label %>)<% } %>.</p>
    <% if (allAccess) { %>
      <p>It unlocks <strong>every episode</strong> &mdash; including all future ones. Watch anytime:</p>
    <% } else { %>
      <p>These are unlocked for you now &mdash; watch anytime:</p>
    <% } %>
    <ul class="promo-links">
      <% links.forEach(l => { %>
        <li><a class="btn" href="<%= l.path %>"><%= l.name %></a></li>
      <% }); %>
    </ul>
    <% if (typeof personalUrl !== 'undefined' && personalUrl) { %>
    <div class="personal-link">
      <h3>Save this link</h3>
      <p>This is your personal unlock link. Save it &mdash; it opens every episode in any browser, on any device, anytime. Don&rsquo;t share it; it&rsquo;s yours.</p>
      <div class="copy-row">
        <input id="personal-url" type="text" readonly value="<%= personalUrl %>" onclick="this.select()" aria-label="Your personal unlock link">
        <button type="button" class="btn" id="copy-personal">Copy</button>
      </div>
    </div>
    <script>
    (function () {
      var btn = document.getElementById('copy-personal');
      var input = document.getElementById('personal-url');
      if (!btn || !input) return;
      btn.addEventListener('click', function () {
        function done() { btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = 'Copy'; }, 2000); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(input.value).then(done, function(){ input.select(); document.execCommand('copy'); done(); });
        } else { input.select(); document.execCommand('copy'); done(); }
      });
    })();
    </script>
    <% } %>
  </div>
</section>

<%- include('partials/footer', { config }) %>
