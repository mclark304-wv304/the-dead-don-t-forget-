<section class="t13-section" id="thirteen-doors">
  <div class="wrap">
    <h2>The Thirteen <span>Doors</span></h2>
    <p class="section-sub">A game of banishing. The risen drift toward the gate &mdash; tap them before they reach it. Spare the weeping mourners.</p>
    <div class="t13-hud">
      <div class="t13-door"><span id="t13-door-num">I</span> &middot; <span id="t13-door-name">The Gate</span></div>
      <div class="t13-lives" id="t13-lives" aria-label="Lives remaining"></div>
      <div class="t13-quota" id="t13-quota">0 / 6</div>
    </div>
    <div class="t13-dreadwrap" aria-label="Dread meter">
      <div class="t13-dread" id="t13-dread"></div>
      <span class="t13-dreadlabel">DREAD</span>
    </div>
    <div class="t13-boardwrap">
      <canvas id="t13-board"></canvas>
      <div class="t13-overlay" id="t13-overlay" hidden></div>
    </div>
    <p class="t13-score">Souls banished: <strong id="t13-score">0</strong> &middot; Best: <strong id="t13-best">0</strong></p>
  </div>
</section>
