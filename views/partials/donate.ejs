<% const _compact = (typeof compact !== 'undefined' && compact); %>
<% global.__donateN = (global.__donateN || 0) + 1; const _ppid = 'paypal-donate-' + global.__donateN; %>
<div class="donate-block<%= _compact ? ' donate-compact' : '' %>" data-donate>
  <% if (!_compact) { %>
    <p class="donate-cta">Like what you hear in the dark?
      <button type="button" class="btn-blood btn-blood-sm" data-donate-toggle>Feed the dead 🖤</button>
    </p>
  <% } else { %>
    <button type="button" class="btn-blood btn-blood-sm" data-donate-toggle>Feed the dead 🖤</button>
  <% } %>
  <div class="donate-form" data-donate-form hidden>
    <div id="<%= _ppid %>" data-paypal-hosted data-hosted-id="JKYFZ53DLW28Y"></div>
    <p class="donate-note">Secure, through PayPal. Any amount keeps the whispers coming.</p>
  </div>
</div>
