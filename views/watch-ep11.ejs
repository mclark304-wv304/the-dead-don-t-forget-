<%- include('partials/header', { active: 'bonus', pageTitle: 'Episode 11 Early Access', config }) %>

<section>
  <div class="wrap gate">
    <h2>Episode 11 — <span>Early Access</span></h2>
    <% if (config.ep11VideoId) { %>
      <p>You're watching before anyone else. Welcome to the premiere.</p>
      <div class="player" style="max-width:900px;margin:0 auto">
        <iframe src="https://www.youtube-nocookie.com/embed/<%= config.ep11VideoId %>" title="The Dead Don't Forget — Episode 11 (Early Access)" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    <% } else { %>
      <p><strong>You're on the list.</strong></p>
      <p>Episode 11 hasn't premiered yet — but you already own your front-row seat. The moment it's ready, it appears right here, before it goes anywhere else. We'll see you at the gate.</p>
      <a class="btn ghost" href="/episodes">Rewatch Episodes 1&ndash;3 while you wait</a>
    <% } %>
  </div>
</section>

<%- include('partials/footer', { config }) %>
