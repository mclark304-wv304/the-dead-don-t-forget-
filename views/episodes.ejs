<%- include('partials/header', { active: 'episodes', pageTitle: 'Episodes', config }) %>

<section>
  <div class="wrap">
    <h2>All <span>Episodes</span></h2>
    <p class="section-sub">The first three episodes stream free, right here. The rest are website exclusives.</p>

    <% config.episodes.forEach(ep => { %>
    <div class="episode-block">
      <div class="player">
        <iframe src="https://www.youtube-nocookie.com/embed/<%= ep.youtubeId %>" title="The Dead Don't Forget — Episode <%= ep.n %>: <%= ep.title %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
      <h3>Episode <%= ep.n %>: <%= ep.title %></h3>
      <div class="meta"><%= ep.runtime %> &middot; <a href="https://youtu.be/<%= ep.youtubeId %>" target="_blank" rel="noopener">Watch on YouTube</a></div>
      <p class="section-sub"><%= ep.synopsis %></p>
    </div>
    <% }) %>

    <div class="handoff-card">
      <div class="handoff-kicker">THE STORY DOESN'T STOP HERE</div>
      <h3>Finished Episode 3? The Ledger was only the beginning.</h3>
      <p class="section-sub">Episode 4: "The Man That Wasn't There" — a man who was never there, and Daniel can't stop remembering him. Website exclusive. Pay once, yours forever.</p>
      <div class="cta-row">
        <a class="btn" href="/bonus">Continue the story — $2.00</a>
        <% if (config.trailers && config.trailers[4]) { %>
        <button type="button" class="btn ghost trailer-btn" data-trailer="<%= config.trailers[4] %>" data-title="Episode 4: The Man That Wasn't There">&#9654; Watch the trailer</button>
        <% } %>
      </div>
    </div>

    <% /* Locked-card art and trailers live in config.js (lockedArt, trailers).
         Any locked episode without an entry falls back to series key art. */ %>
    <% config.lockedEpisodes.forEach(ep => {
      const lockedArt = (config.lockedArt && config.lockedArt[ep.n]) || '/img/series-key-art.webp';
    %>
    <div class="episode-block locked-episode">
      <div class="locked-poster">
        <img src="<%= lockedArt %>?v=<%= config.assetV %>" alt="Episode <%= ep.n %>: <%= ep.title %> — locked" loading="lazy">
        <span class="locked-badge">LOCKED</span>
        <% if (config.trailers && config.trailers[ep.n]) { %>
        <button type="button" class="trailer-btn" data-trailer="<%= config.trailers[ep.n] %>" data-title="Episode <%= ep.n %>: <%= ep.title %>">&#9654; Trailer</button>
        <% } %>
      </div>
      <h3>Episode <%= ep.n %>: <%= ep.title %></h3>
      <div class="meta"><%= ep.runtime %> &middot; Website Exclusive</div>
      <p class="section-sub"><%= ep.synopsis %></p>
      <a class="btn" href="/bonus">Unlock in the Bonus Store — $2.00</a>
    </div>
    <% }) %>

    <h2>Teasers &amp; <span>Shorts</span></h2>
    <p class="section-sub">Quick hits. Share them everywhere.</p>
    <div class="shorts-row">
      <% config.shorts.forEach(s => { %>
        <a class="btn ghost" href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %> &#9654;</a>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/trailer-modal', {}) %>

<%- include('partials/footer', { config }) %>
